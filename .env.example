# Copia este archivo a ".env" (o define estas variables de entorno de otra
# forma) para habilitar el envio de alertas por correo y/o webhook de chat
# corporativo (Teams, Slack, Google Chat), y opcionalmente proteger el
# Portal de Monitoreo con una clave de acceso.
#
# Nadie envia nada automaticamente: las variables de alertas solo habilitan
# los botones de "Enviar alerta" en la app, que el usuario dispara
# manualmente.

# --- Portal de Monitoreo (acceso simple, no un sistema de usuarios) ---
# Si se deja vacio/sin definir, el portal queda abierto sin pedir clave.
PORTAL_PASSWORD=

# --- Correo (SMTP) ---
SMTP_HOST=smtp.tu-dominio.com
SMTP_PORT=587
SMTP_USER=alertas@tu-dominio.com
SMTP_PASSWORD=
SMTP_FROM=alertas@tu-dominio.com

# --- Webhook de chat corporativo (Teams, Slack o Google Chat) ---
# En Teams: crea un conector "Incoming Webhook" en el canal y pega la URL.
# En Slack: crea una "Incoming Webhook App" en el workspace.
# En Google Chat: usa la URL del webhook del espacio.
ALERTAS_WEBHOOK_URL=
